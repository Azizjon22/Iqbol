DATABASE_URL="postgresql://iqbol:iqbol@localhost:5437/iqbol?schema=public"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=3011
WEB_ORIGIN="http://localhost:3010"

# Empty S3 settings store photos and videos in apps/api/uploads.
# Fill these for MinIO or Cloudflare R2 later; the upload API stays the same.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Telegram bot (shopping-list reminders, PDF reports, mini app). Empty token = bot off.
# Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=""
# Reminder times, comma-separated HH:MM in TELEGRAM_TIMEZONE.
TELEGRAM_REMINDER_TIMES="09:00,20:00"
TELEGRAM_TIMEZONE="Asia/Tashkent"
# Site address the bot's buttons open. With an https address (the real domain,
# or a tunnel) the buttons and the chat menu open the site as a Telegram mini app.
TELEGRAM_WEB_URL="http://localhost:3010"
